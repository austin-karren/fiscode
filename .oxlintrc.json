{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "react-hooks"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-console": "off"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.output/**",
    "**/.nitro/**",
    "**/.vercel/**",
    "**/.wrangler/**",
    "**/.tanstack/**",
    "**/.source/**",
    "**/.turbo/**",
    "**/routeTree.gen.ts",
    "**/*.d.ts",
    "**/_generated/**"
  ],
  "overrides": [
    {
      "files": ["packages/tax/src/**/*.ts"],
      "rules": {
        "typescript/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@fiscode/csv",
                "allowTypeImports": true,
                "message": "@fiscode/tax may only `import type` from @fiscode/csv: the tax engine reads a Bundle but must not load the CSV layer."
              }
            ],
            "patterns": [
              {
                "group": ["@fiscode/csv/*"],
                "allowTypeImports": true,
                "message": "@fiscode/tax may only `import type` from @fiscode/csv: the tax engine reads a Bundle but must not load the CSV layer."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/tax/src/**/*.test.ts", "packages/tax/src/fixtures/**"],
      "rules": {
        "typescript/no-restricted-imports": "off"
      }
    }
  ]
}
