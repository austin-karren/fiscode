{
  "name": "fiscode",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^6",
      "@types/node": "^22.13.14",
      "react": "^19.2.6",
      "react-dom": "^19.2.6",
      "@types/react": "^19.2.15",
      "@types/react-dom": "^19.2.3",
      "zod": "^4.1.13",
      "next-themes": "^0.4.6",
      "ulid": "^3.0.0",
      "papaparse": "^5.5.3",
      "@types/papaparse": "^5.3.16",
      "drizzle-orm": "^0.45.1",
      "drizzle-kit": "^0.31.8",
      "sqlocal": "^0.16.0",
      "vitest": "^3.2.4",
      "@vitest/ui": "^3.2.4",
      "jsdom": "^29.0.2",
      "@testing-library/react": "^16.3.2",
      "@testing-library/dom": "^10.4.1",
      "@testing-library/jest-dom": "^6.6.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo -F web dev",
    "dev:fumadocs": "turbo -F fumadocs dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "check": "oxlint && oxfmt --check",
    "format": "oxfmt --write",
    "db:generate": "turbo -F @fiscode/db db:generate",
    "smoke:tax-fetch": "bun packages/tax/scripts/smoke-fetch.ts",
    "example:csv": "bun packages/csv/scripts/generate-example.ts"
  },
  "devDependencies": {
    "@fiscode/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "turbo": "^2.8.12",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
