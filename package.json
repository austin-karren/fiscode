{
  "name": "fiscode",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^7.0.2",
      "@types/node": "^24.19.2",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "zod": "^4.6.7",
      "ulid": "^3.0.2",
      "papaparse": "^5.7.1",
      "@types/papaparse": "^5.5.2",
      "drizzle-orm": "^0.45.4",
      "drizzle-kit": "^0.31.11",
      "sqlocal": "^0.18.0",
      "vitest": "^5.1.1",
      "jsdom": "^31.0.1",
      "@testing-library/react": "^16.3.3",
      "@testing-library/dom": "^10.4.2",
      "@testing-library/jest-dom": "^8.0.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo -F web dev",
    "dev:fumadocs": "turbo -F fumadocs dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "check": "oxlint && oxfmt --check",
    "format": "oxfmt --write",
    "db:generate": "turbo -F @fiscode/db db:generate",
    "smoke:tax-fetch": "bun packages/tax/scripts/smoke-fetch.ts",
    "example:csv": "bun packages/csv/scripts/generate-example.ts"
  },
  "devDependencies": {
    "@fiscode/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "turbo": "^2.11.13",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
